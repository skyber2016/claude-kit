{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo '$INPUT' | node .agents/hooks/validate-tool-call.mjs"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp", "--api-key", "YOUR_API_KEY"]
    }
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(python .agents/scripts/*)",
      "Bash(node .agents/hooks/*)",
      "Bash(npx *)",
      "Bash(git *)"
    ]
  }
}
